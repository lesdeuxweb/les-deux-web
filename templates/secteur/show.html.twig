{% extends 'base.html.twig' %}

{% set titre = 'secteur.show.titre'|trans({'%cible%': secteur.libelleCible ?: secteur.nom|lower}) %}
{% set fil_ariane = [{libelle: titre}] %}

{% block title %}{{ secteur.metaTitle ?: titre ~ ' | ' ~ site.nom }}{% endblock %}
{% block meta_description %}{{ secteur.metaDescription ?: secteur.accroche ?: 'secteur.show.description'|trans({'%cible%': secteur.libelleCible ?: secteur.nom|lower}) }}{% endblock %}

{% block body %}
    <div class="conteneur">
        <header class="tete-page">
            <h1>{{ titre }}</h1>
            {% if secteur.accroche %}<p class="tete-page__chapeau">{{ secteur.accroche }}</p>{% endif %}
            <div class="groupe-boutons">
                <twig:Bouton href="{{ path('app_contact') }}">{{ 'nav.devis'|trans }}</twig:Bouton>
            </div>
        </header>

        {% if secteur.contenu %}
            <div class="prose">{{ secteur.contenu|contenu_html }}</div>
        {% endif %}

        {{ include('partials/_realisations_liees.html.twig', {
            titre: 'secteur.show.realisations'|trans({'%cible%': secteur.libelleCible ?: secteur.nom|lower}),
            lien_tout: path('app_realisation_index', {secteur: secteur.slug}),
        }) }}

        {{ include('partials/_offres_liees.html.twig') }}

        <div class="section">
            <twig:AppelAction />
        </div>
    </div>
{% endblock %}

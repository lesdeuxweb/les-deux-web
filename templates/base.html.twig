{#
 # Layout principal du site public.
 #
 # Blocs à surcharger dans les pages :
 #   title / meta_description : balises SEO (valeurs par défaut traduites)
 #   body                     : contenu principal, placé dans <main id="contenu">
 #
 # Variable facultative :
 #   fil_ariane : liste d'éléments {libelle, url} sans l'accueil (ajouté automatiquement).
 #               Le dernier élément est la page courante : son url peut être omise.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'layout.titre_defaut'|trans({'%nom%': site.nom}) }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ 'layout.description_defaut'|trans }}{% endblock %}">
        <meta name="theme-color" content="#2E5E4E">

        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
        <link rel="preload" href="{{ asset('fonts/atkinson-hyperlegible-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/bitter-latin-700-normal.woff2') }}" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="lien-evitement" href="#contenu">{{ 'layout.lien_evitement'|trans }}</a>

        {{ include('partials/_entete.html.twig') }}

        <main id="contenu" tabindex="-1">
            {% if fil_ariane is defined %}
                <div class="conteneur">
                    <twig:FilAriane :elements="fil_ariane" />
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_pied.html.twig') }}
    </body>
</html>

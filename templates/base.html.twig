{#
 # Layout principal du site public.
 #
 # Blocs à surcharger dans les pages :
 #   title            : <title> et og:title (défaut traduit)
 #   meta_description : meta description et og:description, nettoyée et coupée à 160 caractères
 #   canonical        : URL canonique absolue (défaut : route courante, sans paramètres de requête)
 #   og_type / og_image : Open Graph (défaut : website / image de partage du logo)
 #   body             : contenu principal, placé dans <main id="contenu">
 #
 # Variable facultative :
 #   fil_ariane : liste d'éléments {libelle, url} sans l'accueil (ajouté automatiquement).
 #               Le dernier élément est la page courante : son url peut être omise.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Blocs SEO déclarés ici sans être affichés : ils sont lus plus bas via block() #}
        {% if false %}
            {% block title %}{{ 'layout.titre_defaut'|trans({'%nom%': site.nom}) }}{% endblock %}
            {% block meta_description %}{{ 'layout.description_defaut'|trans }}{% endblock %}
            {% block canonical %}{{ app.current_route ? url(app.current_route, app.current_route_parameters) }}{% endblock %}
            {% block og_type %}website{% endblock %}
            {% block og_image %}{{ absolute_url(asset('images/logo/og-image.jpg')) }}{% endblock %}
        {% endif %}
        {% set seo_titre = block('title')|trim %}
        {% set seo_description = block('meta_description')|resume_meta %}
        {% set seo_canonical = block('canonical')|trim %}

        <title>{{ seo_titre }}</title>
        <meta name="description" content="{{ seo_description }}">
        {% if seo_canonical %}<link rel="canonical" href="{{ seo_canonical }}">{% endif %}
        <meta name="theme-color" content="#2E5E4E">
        {% if not seo_canonical %}<meta name="robots" content="noindex">{% endif %}

        {# Open Graph : aperçu lors d'un partage (Facebook, LinkedIn, WhatsApp...) #}
        <meta property="og:type" content="{{ block('og_type')|trim }}">
        <meta property="og:site_name" content="{{ site.nom }}">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ seo_titre }}">
        <meta property="og:description" content="{{ seo_description }}">
        {% if seo_canonical %}<meta property="og:url" content="{{ seo_canonical }}">{% endif %}
        <meta property="og:image" content="{{ block('og_image')|trim }}">

        {{ include('partials/_donnees_structurees.html.twig') }}

        <link rel="icon" href="{{ asset('images/logo/favicon-48.png') }}" type="image/png">
        <link rel="apple-touch-icon" href="{{ asset('images/logo/apple-touch-icon.png') }}">
        <link rel="preload" href="{{ asset('fonts/atkinson-hyperlegible-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/bitter-latin-700-normal.woff2') }}" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="lien-evitement" href="#contenu">{{ 'layout.lien_evitement'|trans }}</a>

        {{ include('partials/_entete.html.twig') }}

        <main id="contenu" tabindex="-1">
            {% if fil_ariane is defined %}
                <div class="conteneur">
                    <twig:FilAriane :elements="fil_ariane" />
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_pied.html.twig') }}
        {{ include('partials/_matomo.html.twig') }}
    </body>
</html>

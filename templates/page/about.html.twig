{% extends 'base.html.twig' %}

{% set fil_ariane = [{libelle: 'nav.a_propos'|trans}] %}

{% block title %}{{ 'about.titre_page'|trans({'%nom%': site.nom}) }}{% endblock %}
{% block meta_description %}{{ 'about.description'|trans({'%ville%': site.ville}) }}{% endblock %}

{% block body %}
    <div class="conteneur">
        <header class="tete-page">
            <h1>{{ 'about.titre'|trans }}</h1>
            <p class="tete-page__chapeau">{{ 'about.chapeau'|trans({'%ville%': site.ville}) }}</p>
        </header>

        <section class="bloc" aria-labelledby="titre-equipe">
            <h2 id="titre-equipe" class="visuellement-cache">{{ 'about.equipe'|trans }}</h2>
            <ul class="associes" role="list">
                {% for associe in site.associes %}
                    <li class="associe">
                        <twig:Portrait :associe="associe" taille="grand" />
                        <div class="associe__texte">
                            <h3 class="associe__nom"><twig:ACompleter :valeur="associe.prenom" /></h3>
                            <p class="associe__role">{{ associe.role }}</p>
                            <p><twig:ACompleter :valeur="associe.presentation" /></p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section class="bloc prose" aria-labelledby="titre-histoire">
            <h2 id="titre-histoire">{{ 'about.histoire'|trans }}</h2>
            <p><span class="a-completer">{{ 'about.histoire_a_completer'|trans }}</span></p>
        </section>

        <section class="bloc" aria-labelledby="titre-valeurs">
            <h2 id="titre-valeurs">{{ 'about.valeurs'|trans }}</h2>
            <p><span class="a-completer">{{ 'about.valeurs_a_completer'|trans }}</span></p>
            <ul class="grille-arguments" role="list">
                {% for cle in ['proximite', 'interlocuteurs', 'hebergement', 'propriete'] %}
                    <li class="argument">
                        <h3 class="argument__titre">{{ ('arguments.' ~ cle ~ '.titre')|trans }}</h3>
                        <p>{{ ('arguments.' ~ cle ~ '.texte')|trans({'%ville%': site.ville, '%rayon%': site.rayon_km}) }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <div class="section">
            <twig:AppelAction titre="{{ 'about.cta_titre'|trans }}" />
        </div>
    </div>
{% endblock %}

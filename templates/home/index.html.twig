{# Site en une page (maquette Figma) : hero, manifeste, offres, façon de faire, qui sommes-nous, zones, contact. #}
{% extends 'base.html.twig' %}

{% block body %}
    {# --- Hero : accroche à gauche, photo à droite --- #}
    <section class="hero" aria-labelledby="titre-accueil">
        <div class="hero__texte">
            <twig:SurTitre>{{ 'accueil.hero.sur_titre'|trans({'%ville%': site.ville}) }}</twig:SurTitre>
            <h1 id="titre-accueil">{{ 'accueil.hero.titre'|trans }} <em>{{ 'accueil.hero.titre_accent'|trans }}</em></h1>
            <p class="hero__sous-titre">{{ 'accueil.hero.sous_titre'|trans }}</p>
            <div class="groupe-boutons">
                <twig:Bouton href="#contact">{{ 'accueil.hero.devis'|trans }}</twig:Bouton>
                <twig:Bouton href="#offres" variante="lien">{{ 'accueil.hero.voir_offres'|trans }}</twig:Bouton>
            </div>
            <ul class="liste-coches liste-coches--ligne hero__garanties" role="list">
                <li>{{ 'accueil.hero.garantie_interlocuteur'|trans }}</li>
                <li>{{ 'accueil.hero.garantie_hebergement'|trans }}</li>
                <li>{{ 'accueil.hero.garantie_engagement'|trans }}</li>
            </ul>
        </div>

        <div class="hero__visuel">
            {% if site.photo_accueil %}
                <img src="{{ asset('images/' ~ site.photo_accueil) }}" alt="" width="1200" height="1400" fetchpriority="high">
            {% else %}
                <p class="hero__visuel-absent">{{ 'accueil.hero.photo_a_venir'|trans }}<small>[À COMPLÉTER]</small></p>
            {% endif %}
            <p class="hero__etiquette">{{ 'accueil.hero.etiquette'|trans }}</p>
            <p class="hero__zone">
                <span class="hero__zone-libelle">{{ 'accueil.hero.zone_libelle'|trans }}</span>
                <span class="hero__zone-distance">≈&nbsp;{{ site.rayon_km }}&nbsp;km</span>
                <span class="hero__zone-lieu">{{ 'accueil.hero.zone_lieu'|trans({'%ville%': site.ville}) }}</span>
            </p>
        </div>
    </section>

    {# --- Manifeste --- #}
    <section class="section" aria-label="{{ 'accueil.manifeste.sur_titre'|trans }}">
        <div class="conteneur manifeste">
            <twig:SurTitre>{{ 'accueil.manifeste.sur_titre'|trans }}</twig:SurTitre>
            <p class="manifeste__texte">{{ 'accueil.manifeste.texte'|trans }} <em>{{ 'accueil.manifeste.texte_accent'|trans }}</em></p>
        </div>
    </section>

    {# --- Nos offres : 3 cartes, puis grille complète dépliable (sans JavaScript : <details>) --- #}
    <section class="section" id="offres" aria-labelledby="titre-offres">
        <div class="conteneur">
            <div class="section-tete">
                <div>
                    <twig:SurTitre>{{ 'accueil.offres.sur_titre'|trans }}</twig:SurTitre>
                    <h2 id="titre-offres">{{ 'accueil.offres.titre'|trans }}</h2>
                </div>
                <p class="section-tete__intro">{{ 'accueil.offres.intro'|trans }}</p>
            </div>

            {% if cartes is not empty %}
                <ul class="grille-cartes grille-offres" role="list">
                    {% for offre in cartes %}
                        <li><twig:CarteOffre :offre="offre" :numero="loop.index" /></li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if autres_creations is not empty or options is not empty or abonnements is not empty %}
                <details class="grille-complete">
                    <summary class="grille-complete__bouton">
                        <span class="grille-complete__voir">{{ 'accueil.offres.voir_tout'|trans }}</span>
                        <span class="grille-complete__masquer">{{ 'accueil.offres.masquer'|trans }}</span>
                    </summary>

                    <div class="grille-complete__contenu">
                        {% if autres_creations is not empty %}
                            <div class="tableau-defilant">
                                <table class="tableau-offres">
                                    <caption class="visuellement-cache">{{ 'accueil.offres.autres_creations'|trans }}</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">{{ 'accueil.offres.colonne_offre'|trans }}</th>
                                            <th scope="col">{{ 'accueil.offres.colonne_contenu'|trans }}</th>
                                            <th scope="col">{{ 'accueil.offres.colonne_prix'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for offre in autres_creations %}
                                            <tr>
                                                <th scope="row"><a href="{{ path('app_home', {offre: offre.slug}) }}#contact">{{ offre.nom }}</a></th>
                                                <td>{{ offre.accroche }}</td>
                                                <td class="tableau-offres__prix">{{ offre.prixAffiche }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}

                        {% if options is not empty %}
                            <div class="options-carte">
                                <div>
                                    <twig:SurTitre class="sur-titre--sans-trait">{{ 'accueil.offres.options_sur_titre'|trans }}</twig:SurTitre>
                                    <h3 class="options-carte__titre">{{ 'accueil.offres.options'|trans }}</h3>
                                </div>
                                <ul class="options-liste" role="list">
                                    {% for option in options %}
                                        <li><span>{{ option.nom }}</span><strong>{{ option.prix }}</strong></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if abonnements is not empty %}
                            <div class="abonnements">
                                <twig:SurTitre class="sur-titre--sans-trait">{{ 'accueil.offres.abonnements_sur_titre'|trans }}</twig:SurTitre>
                                <h3 class="options-carte__titre">{{ 'accueil.offres.abonnements'|trans }}</h3>
                                <div class="tableau-defilant">
                                    <table class="tableau-offres">
                                        <thead>
                                            <tr>
                                                <th scope="col">{{ 'accueil.offres.colonne_pack'|trans }}</th>
                                                <th scope="col">{{ 'accueil.offres.colonne_compris'|trans }}</th>
                                                <th scope="col">{{ 'accueil.offres.colonne_prix'|trans }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for offre in abonnements %}
                                                <tr>
                                                    <th scope="row"><a href="{{ path('app_home', {offre: offre.slug}) }}#contact">{{ offre.nom }}</a></th>
                                                    <td>{{ offre.pointsForts|join(', ') }}.</td>
                                                    <td class="tableau-offres__prix">{{ offre.prixAffiche }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </details>
            {% endif %}

            {% if site.mention_tva %}<p class="mention-tva">{{ site.mention_tva }}</p>{% endif %}
        </div>
    </section>

    {# --- Notre façon de faire (étapes) --- #}
    <section class="section section--sombre" aria-labelledby="titre-methode">
        <div class="conteneur deux-colonnes">
            <div>
                <twig:SurTitre>{{ 'accueil.methode.sur_titre'|trans }}</twig:SurTitre>
                <h2 id="titre-methode">{{ 'accueil.methode.titre'|trans }}</h2>
                <p class="texte-doux">{{ 'accueil.methode.texte'|trans }}</p>
                <p><twig:Bouton href="#contact" variante="lien">{{ 'accueil.methode.lien'|trans }}</twig:Bouton></p>
            </div>
            <ol class="etapes" role="list">
                {% for i in 1..4 %}
                    <li class="etape">
                        <span class="etape__numero" aria-hidden="true">{{ '%02d'|format(i) }}</span>
                        <div>
                            <h3 class="etape__titre">{{ ('accueil.methode.etape' ~ i ~ '.titre')|trans }}</h3>
                            <p>{{ ('accueil.methode.etape' ~ i ~ '.texte')|trans }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# --- Qui sommes-nous --- #}
    <section class="section" id="qui-sommes-nous" aria-labelledby="titre-apropos">
        <div class="conteneur deux-colonnes deux-colonnes--centre">
            <div class="photos-associes">
                {% for associe in site.associes %}
                    <figure class="photo-associe">
                        {% if associe.photo %}
                            <img src="{{ asset('images/' ~ associe.photo) }}" alt="{{ associe.prenom }}" width="600" height="800" loading="lazy">
                        {% else %}
                            <figcaption class="photo-associe__absente">{{ 'accueil.apropos.photo'|trans({'%numero%': loop.index}) }}<small>[À COMPLÉTER]</small></figcaption>
                        {% endif %}
                    </figure>
                {% endfor %}
                <p class="photos-associes__legende" aria-hidden="true">{{ 'accueil.apropos.legende'|trans }}</p>
            </div>
            <div>
                <twig:SurTitre>{{ 'accueil.apropos.sur_titre'|trans }}</twig:SurTitre>
                <h2 id="titre-apropos">{{ 'accueil.apropos.titre'|trans }}</h2>
                <p class="apropos__chapeau">
                    {{ 'accueil.apropos.nous_sommes'|trans }}
                    <strong><twig:ACompleter :valeur="site.associes[0].prenom" /></strong>, {{ 'accueil.apropos.role_dev'|trans }},
                    {{ 'accueil.apropos.et'|trans }} <strong><twig:ACompleter :valeur="site.associes[1].prenom" /></strong>, {{ 'accueil.apropos.role_projet'|trans }}.
                </p>
                <p class="texte-doux">{{ 'accueil.apropos.histoire'|trans({'%ville%': site.ville}) }}</p>
                <ul class="valeurs" role="list">
                    <li>{{ 'accueil.apropos.valeur_disponibilite'|trans }}</li>
                    <li>{{ 'accueil.apropos.valeur_clarte'|trans }}</li>
                    <li>{{ 'accueil.apropos.valeur_savoir_faire'|trans }}</li>
                </ul>
            </div>
        </div>
    </section>

    {# --- Ici et ailleurs --- #}
    <section class="section section--verte" aria-labelledby="titre-zones">
        <div class="conteneur deux-colonnes">
            <div>
                <twig:SurTitre>{{ 'accueil.zones.sur_titre'|trans }}</twig:SurTitre>
                <h2 id="titre-zones">{{ 'accueil.zones.titre'|trans }}</h2>
            </div>
            <p class="ici-ailleurs__texte">{{ 'accueil.zones.texte'|trans({'%ville%': site.ville, '%rayon%': site.rayon_km}) }}</p>
        </div>
    </section>

    {# --- Contact --- #}
    <section class="section" id="contact" aria-labelledby="titre-contact">
        <div class="conteneur">
            {{ include('contact/_bloc.html.twig', {niveau_titre: 2}) }}
        </div>
    </section>
{% endblock %}

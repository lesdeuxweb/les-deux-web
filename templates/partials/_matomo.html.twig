{#
 # Mesure d'audience Matomo, chargée uniquement si MATOMO_URL et MATOMO_SITE_ID sont définis.
 # Configurée sans cookie (disableCookies) : pas de consentement ni de bandeau nécessaire
 # (exemption CNIL pour la mesure d'audience). Pensez à anonymiser les IP côté Matomo.
 #}
{% if matomo.url is not empty and matomo.site_id is not empty %}
    <script>
        var _paq = window._paq = window._paq || [];
        _paq.push(['disableCookies']);
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = '{{ matomo.url|trim('/', 'right')|e('js') }}/';
            _paq.push(['setTrackerUrl', u + 'matomo.php']);
            _paq.push(['setSiteId', '{{ matomo.site_id|e('js') }}']);
            var g = document.createElement('script');
            g.async = true;
            g.src = u + 'matomo.js';
            document.head.appendChild(g);
        })();
    </script>
{% endif %}

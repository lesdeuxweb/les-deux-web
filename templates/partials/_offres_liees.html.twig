{# Rappel des offres sur les pages secteur et zone. Variable : offres. #}
{% if offres is not empty %}
    <section class="bloc" aria-labelledby="offres-liees">
        <div class="bloc__tete">
            <h2 id="offres-liees">{{ 'offre.nos_offres'|trans }}</h2>
            <a href="{{ path('app_offre_index') }}">{{ 'offre.toutes'|trans }}</a>
        </div>
        <ul class="grille-cartes{{ offres|length % 4 == 0 ? ' grille-cartes--4' }}" role="list">
            {% for offre in offres %}
                <li><twig:CarteOffre :offre="offre" /></li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

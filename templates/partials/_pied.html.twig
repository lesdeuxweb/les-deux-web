{# Pied de page (maquette) : logo, phrase, navigation, liens légaux. #}
{% set accueil = path('app_home') %}
<footer class="pied">
    <div class="conteneur">
        <div class="pied__haut">
            <twig:Logo variante="jaune" />

            <p class="pied__phrase">{{ 'pied.phrase'|trans }}</p>

            <nav aria-label="{{ 'pied.titre_site'|trans }}">
                <ul class="pied__nav">
                    <li><a href="{{ accueil }}#offres">{{ 'nav.offres'|trans }}</a></li>
                    <li><a href="{{ accueil }}#qui-sommes-nous">{{ 'nav.a_propos'|trans }}</a></li>
                    <li><a href="{{ accueil }}#contact">{{ 'nav.contact'|trans }}</a></li>
                </ul>
            </nav>
        </div>

        <div class="pied__bas">
            <p>{{ 'pied.droits'|trans({'%annee%': 'now'|date('Y'), '%nom%': site.nom}) }}</p>
            <nav aria-label="{{ 'pied.titre_infos'|trans }}">
                <ul>
                    <li><a href="{{ path('app_legal') }}">{{ 'pied.mentions_legales'|trans }}</a></li>
                    <li><a href="{{ path('app_privacy') }}">{{ 'pied.confidentialite'|trans }}</a></li>
                </ul>
            </nav>
            <p>{{ 'pied.signature'|trans({'%ville%': site.ville}) }}</p>
        </div>
    </div>
</footer>

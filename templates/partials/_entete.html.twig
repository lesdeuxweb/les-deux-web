{#
 # En-tête (maquette) : logo + liens vers les sections de l'accueil + bouton contact.
 # Les liens sont absolus (/#offres) pour fonctionner aussi depuis les pages légales.
 #}
{% set accueil = path('app_home') %}

<header class="entete" data-controller="menu">
    <div class="conteneur entete__barre">
        <twig:Logo :courant="app.current_route == 'app_home'" />

        <button class="menu-bouton" type="button" hidden
                aria-expanded="false" aria-controls="nav-principale"
                data-menu-target="bouton" data-action="menu#basculer">
            <span class="menu-bouton__icone" aria-hidden="true"></span>
            {{ 'layout.menu'|trans }}
        </button>

        <nav id="nav-principale" class="nav-principale" aria-label="{{ 'layout.nav_principale'|trans }}" data-menu-target="nav">
            <ul class="nav-principale__liste">
                <li><a class="nav-principale__lien" href="{{ accueil }}#offres">{{ 'nav.offres'|trans }}</a></li>
                <li><a class="nav-principale__lien" href="{{ accueil }}#qui-sommes-nous">{{ 'nav.a_propos'|trans }}</a></li>
                <li class="nav-principale__item--devis">
                    <twig:Bouton href="{{ accueil }}#contact" variante="sombre">{{ 'nav.devis'|trans }}</twig:Bouton>
                </li>
            </ul>
        </nav>
    </div>
</header>

{#
 # Carte d'une réalisation (liste, accueil, pages secteur et zone).
 #   <twig:CarteRealisation :realisation="realisation" />
 #
 # niveau      : niveau du titre (3 par défaut).
 # prioritaire : true pour les cartes visibles dès l'ouverture de la page (pas de lazy loading).
 #
 # Dans le HTML, le titre précède l'image (ordre de lecture logique) ;
 # le CSS remet l'image en haut de la carte.
 #}
{% props realisation, niveau = 3, prioritaire = false %}
{% set dimensions = realisation.imageDimensions ?? [1200, 750] %}
<article {{ attributes.defaults({class: 'carte carte--cliquable carte-realisation'}) }}>
    <h{{ niveau }} class="carte__titre">
        <a class="carte__lien" href="{{ path('app_realisation_show', {slug: realisation.slug}) }}">{{ realisation.titre }}</a>
    </h{{ niveau }}>

    {% if realisation.secteur or realisation.ville %}
        <p class="carte__meta">
            {{- realisation.secteur ? realisation.secteur.nom -}}
            {{- realisation.secteur and realisation.ville ? ' · ' -}}
            {{- realisation.ville -}}
        </p>
    {% endif %}

    <p class="carte__texte">{{ realisation.resume }}</p>

    <div class="carte-realisation__visuel">
        {% if realisation.imageName %}
            <img src="{{ vich_uploader_asset(realisation, 'imageFile') }}"
                 alt="{{ realisation.imageAlt }}"
                 width="{{ dimensions[0] }}" height="{{ dimensions[1] }}"
                 {% if prioritaire %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
        {% else %}
            <span class="visuel-absent" aria-hidden="true">{{ realisation.titre|first|upper }}</span>
        {% endif %}
    </div>
</article>

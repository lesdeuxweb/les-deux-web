{#
 # Prix d'une offre : « À partir de 900 € HT », « À partir de 39 € HT/mois » ou « Sur devis ».
 # Le montant est mis en valeur (span .prix__montant). Version texte brut : offre.prixAffiche.
 #   <twig:Prix :offre="offre" />
 #}
{% props offre %}
<p {{ attributes.defaults({class: 'prix'}) }}>
    {%- if offre.prixAPartirDe is null -%}
        <span class="prix__montant">{{ 'offre.sur_devis'|trans }}</span>
    {%- else -%}
        {{ 'offre.a_partir_de'|trans }} <span class="prix__montant">{{ offre.prixAPartirDe|number_format(0, ',', ' ') }}&nbsp;€</span>&nbsp;HT{{ offre.prixSuffixe }}
    {%- endif -%}
</p>

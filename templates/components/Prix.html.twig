{#
 # Prix d'une offre : libellé (« À partir de », « Forfait », « Abonnement ») + montant.
 # Version texte brut : offre.prixAffiche. Mention de TVA : site.mention_tva (sous les grilles).
 #   <twig:Prix :offre="offre" />
 #}
{% props offre %}
<p {{ attributes.defaults({class: 'prix'}) }}>
    {%- if offre.prixAPartirDe is null -%}
        <span class="prix__montant">{{ 'offre.sur_devis'|trans }}</span>
    {%- else -%}
        <span class="prix__libelle">
            {{- (offre.aPartirDe ? 'offre.a_partir_de' : (offre.abonnement ? 'offre.abonnement' : 'offre.forfait'))|trans -}}
        </span>
        <span class="prix__montant">{{ offre.prixAPartirDe|number_format(0, ',', ' ') }}&nbsp;€{% if offre.prixSuffixe %}&nbsp;{{ offre.prixSuffixe }}{% endif %}</span>
    {%- endif -%}
</p>

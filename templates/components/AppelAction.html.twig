{#
 # Section d'appel à l'action vers le contact (fin de page).
 #
 #   <twig:AppelAction />                                   textes par défaut
 #   <twig:AppelAction titre="Un gîte à mettre en ligne ?" lien="{{ path('app_contact', {offre: offre.slug}) }}" />
 #
 # niveau : niveau du titre (2 par défaut) pour respecter la hiérarchie de la page.
 #}
{% props
    titre = 'appel_action.titre'|trans,
    texte = 'appel_action.texte'|trans({'%ville%': site.ville}),
    libelleBouton = 'appel_action.bouton'|trans,
    lien = path('app_contact'),
    niveau = 2
%}
<section {{ attributes.defaults({class: 'appel-action'}) }}>
    <h{{ niveau }} class="appel-action__titre">{{ titre }}</h{{ niveau }}>
    {% if texte %}<p class="appel-action__texte">{{ texte }}</p>{% endif %}
    <twig:Bouton href="{{ lien }}" variante="accent">{{ libelleBouton }}</twig:Bouton>
</section>

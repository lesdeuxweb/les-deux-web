{#
 # Photo d'un associé, ou silhouette de remplacement tant que la photo n'est pas fournie.
 #   <twig:Portrait :associe="associe" taille="grand" />
 #}
{% props associe, taille = 'normal' %}
<div class="portrait portrait--{{ taille }}">
    {% if associe.photo %}
        <img src="{{ asset('images/' ~ associe.photo) }}" alt="" width="320" height="320" loading="lazy">
    {% else %}
        <span class="portrait__absent">{{ 'about.photo_a_venir'|trans }}</span>
    {% endif %}
</div>

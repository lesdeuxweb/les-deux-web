{#
 # Affiche une valeur, ou un repère visible « à compléter » si elle commence par « [ ».
 #   <twig:ACompleter :valeur="site.telephone" />
 #}
{% props valeur = null %}
{%- if valeur is null or valeur starts with '[' -%}
    <span class="a-completer">{{ valeur ?? 'commun.a_completer'|trans }}</span>
{%- else -%}
    {{ valeur }}
{%- endif -%}
